{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livewall.local/schemas/ui-rpc-request-v1.json",
  "title": "LiveWall UI RPC Request v1",
  "type": "object",
  "required": ["protocolVersion", "requestId", "method", "parameters"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "method": {
      "enum": [
        "GetAppState", "ListWallpapers", "ProbeImport", "ImportWallpaper",
        "CancelImport", "ApplyWallpaper", "RemoveWallpaper", "SetWallpaperProperty",
        "SetAssignment", "SetPlaybackPolicy", "Play", "Pause", "Stop",
        "GetDiagnostics", "OpenLogFolder", "ShutdownHost"
      ]
    },
    "parameters": { "type": "object" }
  },
  "additionalProperties": true
}

