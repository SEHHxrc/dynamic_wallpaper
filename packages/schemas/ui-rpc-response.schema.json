{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livewall.local/schemas/ui-rpc-response-v1.json",
  "title": "LiveWall UI RPC Response v1",
  "type": "object",
  "required": ["protocolVersion", "requestId", "success", "result", "error"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "success": { "type": "boolean" },
    "result": { "type": ["object", "null"] },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$" },
            "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "retryable": { "type": "boolean" },
            "details": {
              "type": ["object", "null"],
              "additionalProperties": { "type": "string" }
            }
          },
          "additionalProperties": true
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "success": { "const": true } } },
      "then": {
        "properties": {
          "result": { "type": "object" },
          "error": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "result": { "type": "null" },
          "error": { "type": "object" }
        }
      }
    }
  ],
  "additionalProperties": true
}
